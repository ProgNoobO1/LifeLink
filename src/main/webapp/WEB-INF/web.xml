<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>LifeLink Blood Donation Management System</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- ═══════════════════ AUTH ═══════════════════ -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>backend.servlet.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- ═══════════════════ ADMIN ══════════════════ -->
    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>backend.servlet.AdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/admin/*</url-pattern>
    </servlet-mapping>

    <!-- ═══════════════════ HOSPITAL ═══════════════ -->
    <servlet>
        <servlet-name>HospitalDashboardServlet</servlet-name>
        <servlet-class>backend.servlet.HospitalDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HospitalDashboardServlet</servlet-name>
        <url-pattern>/hospital/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BloodStockServlet</servlet-name>
        <servlet-class>backend.servlet.BloodStockServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BloodStockServlet</servlet-name>
        <url-pattern>/hospital/stock</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AddEditStockServlet</servlet-name>
        <servlet-class>backend.servlet.AddEditStockServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddEditStockServlet</servlet-name>
        <url-pattern>/hospital/stock/form</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HospitalRequestServlet</servlet-name>
        <servlet-class>backend.servlet.HospitalRequestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HospitalRequestServlet</servlet-name>
        <url-pattern>/hospital/requests</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RequestDetailServlet</servlet-name>
        <servlet-class>backend.servlet.RequestDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RequestDetailServlet</servlet-name>
        <url-pattern>/hospital/request/detail</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HospitalNewRequestServlet</servlet-name>
        <servlet-class>backend.servlet.HospitalNewRequestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HospitalNewRequestServlet</servlet-name>
        <url-pattern>/hospital/request/new</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UsageHistoryServlet</servlet-name>
        <servlet-class>backend.servlet.UsageHistoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UsageHistoryServlet</servlet-name>
        <url-pattern>/hospital/history</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HospitalProfileServlet</servlet-name>
        <servlet-class>backend.servlet.HospitalProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HospitalProfileServlet</servlet-name>
        <url-pattern>/hospital/profile</url-pattern>
    </servlet-mapping>



    <!-- ═══════════════════ DONOR ══════════════════ -->
    <servlet>
        <servlet-name>DonorServlet</servlet-name>
        <servlet-class>backend.servlet.DonorServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DonorServlet</servlet-name>
        <url-pattern>/donor/*</url-pattern>
    </servlet-mapping>

    <!-- ═══════════════════ RECIPIENT ══════════════ -->
    <servlet>
        <servlet-name>RecipientServlet</servlet-name>
        <servlet-class>backend.servlet.RecipientServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RecipientServlet</servlet-name>
        <url-pattern>/recipient/*</url-pattern>
    </servlet-mapping>

    <!-- ═══════════════════ SEARCH ═════════════════ -->
    <servlet>
        <servlet-name>SearchServlet</servlet-name>
        <servlet-class>backend.servlet.SearchServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SearchServlet</servlet-name>
        <url-pattern>/search</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RequestDonorServlet</servlet-name>
        <servlet-class>backend.servlet.RequestDonorServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RequestDonorServlet</servlet-name>
        <url-pattern>/hospital/request-donor</url-pattern>
    </servlet-mapping>

    <!-- ═══════════════════ ERROR PAGES ════════════ -->
    <error-page>
        <error-code>404</error-code>
        <location>/views/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/views/error/500.jsp</location>
    </error-page>

</web-app>
