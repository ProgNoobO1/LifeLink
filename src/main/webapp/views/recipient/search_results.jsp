<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ page import="com.lifelink.dao.SearchDAO" %>
<%@ page import="com.lifelink.model.User" %>
<%@ page import="java.time.LocalDate" %>
<%@ page import="java.time.temporal.ChronoUnit" %>
<%@ page import="java.util.Collections" %>
<%@ page import="java.util.List" %>
<%!
    private String esc(Object value){return value==null?"":String.valueOf(value).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}
    private String bgClass(String bg){if("AB+".equals(bg))return"bg-ab-pos";if("AB-".equals(bg))return"bg-ab-neg";if("O+".equals(bg))return"bg-o-pos";if("O-".equals(bg))return"bg-o-neg";if("B+".equals(bg))return"bg-b-pos";if("B-".equals(bg))return"bg-b-neg";if("A-".equals(bg))return"bg-a-neg";return"bg-a-pos";}
    private String initials(String name){if(name==null||name.trim().isEmpty())return"U";String[]p=name.trim().split("\\s+");return p.length>1?(p[0].substring(0,1)+p[p.length-1].substring(0,1)).toUpperCase():p[0].substring(0,Math.min(2,p[0].length())).toUpperCase();}
    private long daysSince(java.sql.Date date){return date==null?0:ChronoUnit.DAYS.between(date.toLocalDate(), LocalDate.now());}
%>
<%
    User currentUser=(User)request.getAttribute("currentUser"); if(currentUser==null)currentUser=(User)session.getAttribute("currentUser"); if(currentUser==null){response.sendRedirect(request.getContextPath()+"/login");return;}
    List<SearchDAO.DonorResult> donors=(List<SearchDAO.DonorResult>)request.getAttribute("donorResults"); if(donors==null)donors=Collections.emptyList();
    List<SearchDAO.HospitalResult> hospitals=(List<SearchDAO.HospitalResult>)request.getAttribute("hospitalResults"); if(hospitals==null)hospitals=Collections.emptyList();
    String bloodGroup=(String)request.getAttribute("selectedBloodGroup"); if(bloodGroup==null||bloodGroup.isEmpty())bloodGroup="Any";
    String location=(String)request.getAttribute("selectedLocation"); if(location==null||location.isEmpty())location="your area";
    Integer availableNow=(Integer)request.getAttribute("availableNow"); if(availableNow==null)availableNow=0;
    Double nearest=(Double)request.getAttribute("nearestDistance"); if(nearest==null)nearest=0.0;
    String fullName=currentUser.getFullName()!=null?currentUser.getFullName():"User"; String email=currentUser.getEmail()!=null?currentUser.getEmail():"";
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Search Results | LifeLink</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}body{min-height:100vh;background:#f6f7f9;color:#1f2937;font-family:'Inter',sans-serif}button{font:inherit}.main-content{min-height:100vh;margin-left:210px}.topbar{position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:78px;padding:1.05rem 2rem;background:#fff;border-bottom:1px solid #eceff3}.topbar-left{display:flex;align-items:center;gap:.85rem}.back-btn,.hamburger{width:34px;height:34px;border:0;border-radius:10px;background:#f1f3f6;color:#667085;display:grid;place-items:center;text-decoration:none;cursor:pointer}.back-btn svg,.hamburger svg{width:20px;height:20px;fill:currentColor}.hamburger{display:none}.page-title h1{font-size:1.25rem;font-weight:800}.page-title p{font-size:.78rem;color:#98a2b3;margin-top:.35rem}.topbar-right{display:flex;align-items:center;gap:.95rem}.top-user{display:flex;align-items:center;gap:.7rem}.avatar{width:38px;height:38px;border-radius:999px;background:linear-gradient(135deg,#b91c1c,#ef4444);color:#fff;display:grid;place-items:center;font-weight:800;font-size:.78rem;border:2px solid #f4d0d0}.top-user strong{display:block;font-size:.84rem}.top-user span{display:block;font-size:.74rem;color:#98a2b3}.chevron{width:18px;height:18px;fill:#98a2b3}.page-body{padding:2.1rem 2.1rem 3rem}.shell{max-width:1120px;margin:0 auto;display:grid;gap:1.45rem}.query-card,.stat-card,.result-row,.side-card{background:#fff;border:1px solid #edf0f4;border-radius:16px;box-shadow:0 1px 3px rgba(16,24,40,.04)}.query-card{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.4rem;flex-wrap:wrap}.query-left{display:flex;align-items:center;gap:1rem;min-width:260px;flex:1}.query-badge{width:56px;height:56px;border-radius:13px;background:#c91c20;color:#fff;display:grid;place-items:center;font-size:1.1rem;font-weight:800;box-shadow:0 10px 18px rgba(185,28,28,.2)}.eyebrow{display:flex;align-items:center;gap:.55rem;color:#98a2b3;text-transform:uppercase;letter-spacing:.05em;font-size:.72rem;font-weight:800}.live{padding:.22rem .55rem;border-radius:999px;background:#ecfdf3;color:#16a34a;text-transform:none;letter-spacing:0}.query-card h2{font-size:1.05rem;margin:.45rem 0 .2rem}.query-card h2 span{color:#c91c20}.query-card p{font-size:.78rem;color:#98a2b3}.filter-pills{display:flex;align-items:center;justify-content:center;gap:.55rem;flex-wrap:wrap;margin-left:auto}.filter-pill,.refine{height:32px;border-radius:9px;border:1px solid #dce2ea;background:#f7f8fa;color:#475467;padding:0 .8rem;font-size:.76rem;font-weight:800;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;cursor:pointer}.filter-pill.red{background:#fee2e2;color:#c91c20;border-color:#fecaca}.refine{background:#c91c20;color:#fff;border:0}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.stat-card{display:flex;align-items:center;gap:1rem;padding:1.15rem}.stat-icon{width:42px;height:42px;border-radius:11px;display:grid;place-items:center}.stat-icon svg{width:20px;height:20px;fill:currentColor}.red-icon{background:#fee2e2;color:#c91c20}.green-icon{background:#ecfdf3;color:#22c55e}.blue-icon{background:#eff6ff;color:#3b82f6}.amber-icon{background:#fffbeb;color:#f59e0b}.stat-value{font-size:1.45rem;font-weight:800}.stat-label{font-size:.78rem;color:#98a2b3;margin-top:.25rem}.layout{display:grid;grid-template-columns:minmax(0,1fr)288px;gap:1.5rem;align-items:start}.tabs-row{display:flex;align-items:center;justify-content:space-between;margin:.2rem 0 1rem}.tabs{display:inline-flex;border:1px solid #dce2ea;border-radius:12px;background:#fff;overflow:hidden}.tab{border:0;background:#fff;color:#667085;padding:.75rem 1.25rem;font-weight:800;font-size:.78rem;cursor:pointer}.tab.active{background:#c91c20;color:#fff}.sort{color:#667085;font-size:.78rem}.results{display:grid;gap:1rem}.result-row{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.15rem}.result-left{display:flex;align-items:center;gap:1rem;min-width:0}.result-avatar{position:relative;width:54px;height:54px;border-radius:14px;background:linear-gradient(135deg,#c91c20,#0ea5e9);color:#fff;display:grid;place-items:center;font-weight:800;flex-shrink:0}.hospital-avatar{background:#eff6ff;color:#3b82f6}.availability-dot{position:absolute;right:-2px;bottom:-2px;width:16px;height:16px;border-radius:50%;background:#22c55e;border:3px solid #fff}.availability-dot.grey{background:#c0c7d1}.result-name{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;font-weight:800}.blood-pill{display:inline-flex;align-items:center;justify-content:center;min-width:34px;height:23px;border-radius:7px;color:#fff;font-size:.72rem;font-weight:800}.bg-a-pos,.bg-o-pos,.bg-b-neg{background:#c91c20}.bg-a-neg,.bg-o-neg{background:#881337}.bg-b-pos{background:#d92d20}.bg-ab-pos{background:#7c3aed}.bg-ab-neg{background:#5b21b6}.type-badge{padding:.22rem .55rem;border-radius:7px;background:#f1f3f6;color:#98a2b3;font-size:.72rem;font-weight:800}.type-badge.hospital{background:#eff6ff;color:#3b82f6}.meta{display:flex;gap:1rem;flex-wrap:wrap;margin-top:.45rem;color:#667085;font-size:.78rem}.status{display:inline-flex;align-items:center;gap:.35rem;border-radius:999px;padding:.45rem .78rem;font-size:.76rem;font-weight:800}.status::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor}.available,.open{background:#ecfdf3;color:#16a34a}.busy{background:#fffbeb;color:#d97706}.unavailable{background:#f1f3f6;color:#98a2b3}.request-btn{display:inline-flex;align-items:center;justify-content:center;gap:.45rem;border:0;border-radius:11px;background:#c91c20;color:#fff;padding:.75rem 1.1rem;text-decoration:none;font-size:.78rem;font-weight:800;box-shadow:0 8px 14px rgba(185,28,28,.2)}.request-btn.disabled{background:#f1f3f6;color:#98a2b3;box-shadow:none;pointer-events:none}.side-stack{display:grid;gap:1.25rem}.side-card{padding:1.25rem}.urgent{background:#c91c20;color:#fff;border:0;overflow:hidden;position:relative}.urgent h3,.urgent p{position:relative;z-index:1}.urgent h3{font-size:.9rem;margin-bottom:.9rem}.urgent p{font-weight:800;line-height:1.55;font-size:.9rem}.call-btn{display:block;text-align:center;margin-top:1rem;background:#fff;color:#c91c20;border-radius:10px;padding:.75rem;text-decoration:none;font-weight:800;font-size:.78rem}.side-card h3{font-size:.9rem;font-weight:800;margin-bottom:1rem}.filter-group{margin-bottom:1rem}.filter-label{font-size:.74rem;color:#667085;text-transform:uppercase;letter-spacing:.05em;font-weight:800;margin-bottom:.55rem}.toggle-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.45rem}.filter-btn{border:0;border-radius:9px;background:#f1f3f6;color:#667085;padding:.65rem .5rem;font-size:.74rem;font-weight:800;cursor:pointer}.filter-btn.active{background:#c91c20;color:#fff}.wide-btn{width:100%;border:0;border-radius:10px;background:#c91c20;color:#fff;padding:.75rem;font-weight:800}.about-list{display:grid;gap:.8rem;color:#667085;font-size:.8rem;line-height:1.45}.about-list div{display:flex;gap:.65rem}.check{width:24px;height:24px;border-radius:8px;background:#fee2e2;color:#c91c20;display:grid;place-items:center;flex-shrink:0;font-weight:800}.empty{padding:2rem;text-align:center;color:#98a2b3;background:#fff;border:1px dashed #dce2ea;border-radius:14px}.skeleton .result-row{opacity:.5}
@media(max-width:1024px){.main-content{margin-left:0}.hamburger{display:grid}.layout{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}}@media(max-width:720px){.topbar{padding:1rem}.top-user div:not(.avatar),.chevron{display:none}.page-body{padding:1rem}.query-card,.result-row{align-items:center;flex-direction:column}.query-left{width:100%;justify-content:center;text-align:center}.stats{grid-template-columns:1fr}.result-left{align-items:flex-start}.filter-pills{width:100%;margin-left:0;justify-content:center}}
</style>
</head>
<body>
<jsp:include page="/includes/recipient_sidebar.jsp" />
<main class="main-content">
<header class="topbar"><div class="topbar-left"><button class="hamburger" onclick="toggleSidebar()" aria-label="Open menu"><svg viewBox="0 0 24 24"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg></button><a class="back-btn" href="${pageContext.request.contextPath}/search"><svg viewBox="0 0 24 24"><path d="m20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.42-1.41L7.83 13H20v-2Z"/></svg></a><div class="page-title"><h1>Search Results</h1><p>Blood availability near you</p></div></div><div class="topbar-right"><jsp:include page="/includes/recipient_notifications.jsp" /><div class="top-user"><div class="avatar"><%= esc(currentUser.getInitials()) %></div><div><strong><%= esc(fullName) %></strong><span><%= esc(email) %></span></div><svg class="chevron" viewBox="0 0 24 24"><path d="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z"/></svg></div></div></header>
<section class="page-body"><div class="shell">
<section class="query-card"><div class="query-left"><div class="query-badge"><%= esc(bloodGroup) %></div><div><div class="eyebrow">Search Query <span class="live">Live Results</span></div><h2>Showing results for <span><%= esc(bloodGroup) %></span> in <span><%= esc(location) %></span></h2><p><%= donors.size() %> donors &middot; <%= hospitals.size() %> hospitals found</p></div></div><div class="filter-pills" aria-label="Active filters"><button class="filter-pill red" type="button"><%= esc(bloodGroup) %></button><button class="filter-pill" type="button"><%= esc(location) %></button><button class="filter-pill" type="button">All Types</button><button class="refine" type="button" onclick="history.back()">Refine</button></div></section>
<section class="stats"><article class="stat-card"><div class="stat-icon red-icon"><svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3 1.34 3 3 3ZM8 11c1.66 0 3-1.34 3-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3Zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13Z"/></svg></div><div><div class="stat-value"><%= donors.size() %></div><div class="stat-label">Donors Found</div></div></article><article class="stat-card"><div class="stat-icon green-icon"><svg viewBox="0 0 24 24"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2Z"/></svg></div><div><div class="stat-value"><%= availableNow %></div><div class="stat-label">Available Now</div></div></article><article class="stat-card"><div class="stat-icon blue-icon"><svg viewBox="0 0 24 24"><path d="M19 3H5v18h14V3Zm-8 16H7v-4h4v4Zm6 0h-4v-4h4v4ZM9 5h6v2H9V5Z"/></svg></div><div><div class="stat-value"><%= hospitals.size() %></div><div class="stat-label">Hospitals</div></div></article><article class="stat-card"><div class="stat-icon amber-icon"><svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Z"/></svg></div><div><div class="stat-value"><%= String.format("%.1f", nearest) %><span style="font-size:.8rem">km</span></div><div class="stat-label">Nearest Result</div></div></article></section>
<div class="layout"><div><div class="tabs-row"><div class="tabs"><button class="tab active" data-type="all">All Results</button><button class="tab" data-type="donor">Donors</button><button class="tab" data-type="hospital">Hospitals</button></div><div class="sort">Sort by: <strong>Nearest</strong></div></div><div class="results" id="resultsList">
<% for(SearchDAO.DonorResult d:donors){ %><article class="result-row" data-result-type="donor" data-available="<%= d.isAvailable() %>" data-distance="<%= String.format("%.1f", d.getDistanceKm()) %>" data-blood-group="<%= esc(d.getBloodGroup()) %>" data-id="<%= d.getId() %>"><div class="result-left"><div class="result-avatar"><%= esc(initials(d.getFullName())) %><span class="availability-dot <%= d.isAvailable()?"":"grey" %>"></span></div><div><div class="result-name"><%= esc(d.getFullName()) %><span class="blood-pill <%= bgClass(d.getBloodGroup()) %>"><%= esc(d.getBloodGroup()) %></span><span class="type-badge">Donor</span></div><div class="meta"><span><%= esc(d.getDistrict()) %></span><span><%= String.format("%.1f",d.getDistanceKm()) %> km away</span><span data-relative-date="<%= d.getLastDonatedAt()==null?"":d.getLastDonatedAt().toString() %>" title="<%= d.getLastDonatedAt()==null?"":d.getLastDonatedAt().toString() %>">Last donated <%= d.getLastDonatedAt()==null?"N/A":daysSince(d.getLastDonatedAt())+" days ago" %></span></div></div></div><span class="status <%= d.isAvailable()?"available":"unavailable" %>"><%= d.isAvailable()?"Available":"Unavailable" %></span><a class="request-btn <%= d.isAvailable()?"":"disabled" %>" href="${pageContext.request.contextPath}/views/recipient/create_request.jsp?bloodGroup=<%= esc(d.getBloodGroup()) %>&donorId=<%= d.getId() %>">Request Blood</a></article><% } %>
<% for(SearchDAO.HospitalResult h:hospitals){ SearchDAO.StockItem selected = h.getStock().isEmpty()?null:h.getStock().get(0); String hBg=selected==null?bloodGroup:selected.getBloodGroup(); int units=selected==null?h.getTotalUnits():selected.getUnitsAvailable(); %><article class="result-row" data-result-type="hospital" data-available="<%= h.isOpen() %>" data-distance="<%= String.format("%.1f", h.getDistanceKm()) %>" data-blood-group="<%= esc(hBg) %>" data-id="<%= h.getId() %>"><div class="result-left"><div class="result-avatar hospital-avatar"><svg style="width:28px;height:28px;fill:currentColor" viewBox="0 0 24 24"><path d="M19 3H5v18h14V3Zm-8 16H7v-4h4v4Zm6 0h-4v-4h4v4ZM9 5h6v2H9V5Z"/></svg></div><div><div class="result-name"><%= esc(h.getHospitalName()) %><span class="blood-pill <%= bgClass(hBg) %>"><%= esc(hBg) %></span><span class="type-badge hospital">Hospital</span></div><div class="meta"><span><%= esc(h.getDistrict()) %></span><span><%= String.format("%.1f",h.getDistanceKm()) %> km away</span><span><%= units %> units of <%= esc(hBg) %> in stock</span></div></div></div><span class="status <%= h.isOpen()?"open":"busy" %>"><%= h.isOpen()?"Open":"Busy" %></span><a class="request-btn" href="${pageContext.request.contextPath}/views/recipient/create_request.jsp?bloodGroup=<%= esc(hBg) %>&hospitalId=<%= h.getId() %>">Request Blood</a></article><% } %>
<div class="empty" id="emptyResults" hidden>No results match these filters.</div></div></div>
<aside class="side-stack"><section class="side-card urgent"><h3>URGENT TIP</h3><p>Need blood immediately? Contact the nearest hospital first for fastest access.</p><a class="call-btn" href="#">Call Nearest Hospital</a></section><section class="side-card"><h3>Filter Results</h3><div class="filter-group"><div class="filter-label">Result Type</div><div class="toggle-grid"><button class="filter-btn active" data-side-type="all">All</button><button class="filter-btn" data-side-type="donor">Donors</button><button class="filter-btn" data-side-type="hospital">Hospitals</button></div></div><div class="filter-group"><div class="filter-label">Availability</div><button class="filter-btn active" style="width:100%;text-align:left" data-availability="available">Available Now <strong style="float:right"><%= availableNow %></strong></button><button class="filter-btn" style="width:100%;text-align:left;margin-top:.5rem" data-availability="all">All Results <strong style="float:right"><%= donors.size()+hospitals.size() %></strong></button></div><div class="filter-group"><div class="filter-label">Max Distance</div><div class="toggle-grid" style="grid-template-columns:repeat(4,1fr)"><button class="filter-btn" data-distance="2">2 km</button><button class="filter-btn" data-distance="5">5 km</button><button class="filter-btn active" data-distance="15">15 km</button><button class="filter-btn" data-distance="any">Any</button></div></div><button class="wide-btn" id="applyFilters" type="button">Apply Filters</button></section><section class="side-card"><h3>About <span id="aboutBlood"><%= esc(bloodGroup) %></span></h3><div class="about-list"><div><span class="check">✓</span><span id="compatibilityInfo">Compatibility details loading.</span></div><div><span class="check">✓</span><span>Request multiple donors to ensure availability.</span></div></div></section></aside></div>
</div></section></main>
<script>
window.selectedBloodGroup='<%= esc(bloodGroup) %>';
window.LifeLinkSearch = {
    requestPath: '${pageContext.request.contextPath}/views/recipient/create_request.jsp'
};
</script>
<script src="${pageContext.request.contextPath}/views/recipient/search.js"></script>
</body></html>
