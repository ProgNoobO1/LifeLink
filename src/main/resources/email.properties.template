# LifeLink Email Configuration
# Copy this file to one of the locations below and fill in real values:
#   1.  ~/.lifelink/email.properties  (recommended — never committed)
#   2.  src/main/resources/email.properties  (not recommended — goes into git)
#
# For Gmail SMTP: generate an App Password at https://myaccount.google.com/apppasswords

smtp.host=smtp.gmail.com
smtp.port=587
smtp.auth=true
smtp.starttls=true

mail.from=YOUR_EMAIL@gmail.com
mail.password=YOUR_APP_PASSWORD

mail.from.name=LifeLink Blood Management
